PORT=3001
JWT_SECRET=cambia_esto_por_una_cadena_aleatoria_larga

# Vacio -> SQLite local (backend/data/repartix.sqlite). En produccion,
# una URL de Postgres (Railway la inyecta solo al anadir el plugin de Postgres).
DATABASE_URL=

# Vacio (desarrollo) -> CORS admite cualquier origen. En produccion, la URL
# publica del frontend desplegado (separa varias con comas si hace falta).
FRONTEND_URL=

# Google AI Studio: https://aistudio.google.com/apikey (gratis, sin tarjeta)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Cloudinary: https://cloudinary.com/users/register/free (plan gratuito)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
